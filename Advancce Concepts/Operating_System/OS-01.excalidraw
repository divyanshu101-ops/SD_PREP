      "text": "Stack - Automatic, Fast, Limited size (Stack Overflow)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stack - Automatic, Fast, Limited size (Stack Overflow)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "f9jqUyCXwJJeNv4U9QKCT",
      "type": "text",
      "x": 6007.491432794789,
      "y": 1637.4740989743727,
      "width": 619.4296875,
      "height": 634.2642423748198,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5R",
      "roundness": null,
      "seed": 878278852,
      "version": 193,
      "versionNonce": 744408060,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790820505172,
      "created": 1790820253092,
      "link": null,
      "locked": false,
      "text": "#include <iostream>\nusing namespace std;\n\n// Function that creates an integer on the heap and returns its address\nint* createScore() {\n    // 'new' requests memory from the heap at runtime\n    // 'ptr' itself lives on the stack, but it points to heap memory\n    int* ptr = new int;\n\n    // Store a value in the heap memory by dereferencing the pointer\n    *ptr = 95;\n\n    // Return the heap address. The memory stays alive after the function\n    // ends, because heap memory is not destroyed automatically.\n    return ptr;\n}\n\nint main() {\n    // Receive the heap address from the function and store it in myScore\n    int* myScore = createScore();\n\n    // Dereference the pointer to read the value from the heap\n    cout << \"Score is: \" << *myScore << endl; // Output: 95\n\n    // Heap memory must be freed manually.\n    // Without this, a memory leak occurs.\n    delete myScore;\n\n    return 0;\n}",
      "fontSize": 16.913713129995195,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <iostream>\nusing namespace std;\n\n// Function that creates an integer on the heap and returns its address\nint* createScore() {\n    // 'new' requests memory from the heap at runtime\n    // 'ptr' itself lives on the stack, but it points to heap memory\n    int* ptr = new int;\n\n    // Store a value in the heap memory by dereferencing the pointer\n    *ptr = 95;\n\n    // Return the heap address. The memory stays alive after the function\n    // ends, because heap memory is not destroyed automatically.\n    return ptr;\n}\n\nint main() {\n    // Receive the heap address from the function and store it in myScore\n    int* myScore = createScore();\n\n    // Dereference the pointer to read the value from the heap\n    cout << \"Score is: \" << *myScore << endl; // Output: 95\n\n    // Heap memory must be freed manually.\n    // Without this, a memory leak occurs.\n    delete myScore;\n\n    return 0;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "TcqPA-quPRUswnFrUvddR",
      "type": "text",
      "x": 6721.896388350795,
      "y": 1562.8002826064273,
      "width": 832.6164334878121,
      "height": 800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5S",
      "roundness": null,
      "seed": 1114271684,
      "version": 90,
      "versionNonce": 1717870916,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790820588782,
      "created": 1790820369221,
      "link": null,
      "locked": false,
      "text": "main() starts\n   │\n   ▼\nSTACK: myScore (uninitialized)\n   │\n   ▼\ncreateScore() called  →  new stack frame created\n   │\n   ▼\nSTACK: ptr ──────────────► HEAP: [ garbage ]     ← 'new int' allocates4bytes\n   │\n   ▼\n*ptr = 95\nSTACK: ptr ──────────────► HEAP: [ 95 ]\n   │\n   ▼\nreturn ptr  →  createScore()'s stack frame is destroyed\n               (ptr variable is gone, but the heap block stays alive)\n   │\n   ▼\nSTACK: myScore ──────────► HEAP: [ 95 ]          ← the address was copied\n   │\n   ▼\ncout << *myScore  →  reads 95 from the heap\n   │\n   ▼\ndelete myScore\nSTACK: myScore ──────────► HEAP: [ freed ]       ← memory returned to the\nsystem\n   │                                                (myScore is now a dangling pointer)\n   ▼\nreturn 0  →  main's stack frame is destroyed",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main() starts\n   │\n   ▼\nSTACK: myScore (uninitialized)\n   │\n   ▼\ncreateScore() called  →  new stack frame created\n   │\n   ▼\nSTACK: ptr ──────────────► HEAP: [ garbage ]     ← 'new int' allocates4bytes\n   │\n   ▼\n*ptr = 95\nSTACK: ptr ──────────────► HEAP: [ 95 ]\n   │\n   ▼\nreturn ptr  →  createScore()'s stack frame is destroyed\n               (ptr variable is gone, but the heap block stays alive)\n   │\n   ▼\nSTACK: myScore ──────────► HEAP: [ 95 ]          ← the address was copied\n   │\n   ▼\ncout << *myScore  →  reads 95 from the heap\n   │\n   ▼\ndelete myScore\nSTACK: myScore ──────────► HEAP: [ freed ]       ← memory returned to the system\n   │                                                (myScore is now a dangling pointer)\n   ▼\nreturn 0  →  main's stack frame is destroyed",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
