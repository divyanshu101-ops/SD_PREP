      "isDeleted": false,
      "boundElements": [],
      "updated": 1790819380849,
      "created": 1790819327235,
      "link": null,
      "locked": false,
      "text": "#include <iostream>\nusing namespace std;\n\nvoid bar(int z) {\n    int w = z + 10;\n    cout << \"Inside bar: w = \" << w << endl;\n}\n\nvoid foo(int x) {\n    int y = 5;\n    bar(x + y); // foo call kar raha hai bar ko\n    cout << \"Inside foo\" << endl;\n}\n\nint main() {\n    int a = 2;\n    foo(a); // main call kar raha hai foo ko\n    cout << \"Inside main\" << endl;\n    return 0;\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <iostream>\nusing namespace std;\n\nvoid bar(int z) {\n    int w = z + 10;\n    cout << \"Inside bar: w = \" << w << endl;\n}\n\nvoid foo(int x) {\n    int y = 5;\n    bar(x + y); // foo call kar raha hai bar ko\n    cout << \"Inside foo\" << endl;\n}\n\nint main() {\n    int a = 2;\n    foo(a); // main call kar raha hai foo ko\n    cout << \"Inside main\" << endl;\n    return 0;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
